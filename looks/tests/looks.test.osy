// Looks at work: the site wears the look the app names; a version switched to another look draws the SAME arranged
// content in that look's design; what the new look has no design for is listed before the switch and not drawn after
// it; a look's thumbnails are drawn in that look; and a customer never sees a look a version is only being drafted in.

using Osysharp.Blocks;

[TestFixture]
void Florist() {
  var anna = new Member { Email = "anna@florist.test", PasswordHash = Security.HashPassword("anna-pass-1") };
  new RoleGrant { Member = anna, Role = AppRole.Staff };
}

principal Anna => Member.Single(m => m.Email == "anna@florist.test");

[Test(Florist)]
void the_site_wears_the_look_the_app_names() {
  Ui.Visit("/");
  Assert.Visible("Meadow · Flowers cut this morning");
  Assert.Visible("“The peonies lasted two weeks.”");
  Assert.Visible("✿ A daisy from June");
  Assert.Hidden("Night · Evening bouquets");
  runas (Anna) {
    Assert.Equal("meadow", SiteDefaultLook());
    Assert.Equal("meadow", SiteLook().Look);
    Assert.Equal(3, SiteOffers().Looks.Count);   // Meadow, Night and Frost
    Assert.Equal("Meadow", SiteOffers().Looks.Single(l => l.Value == "meadow").Label);
  }
}

[Test(Florist)]
void switching_a_versions_look_redraws_the_same_arranged_content() {
  runas (Anna) {
    var main = MainVersion().Id;
    var draft = EditRegion(main, "front", "");
    var hero = PlacedBlock.Where(b => b.Arrangement.Id == draft).OrderBy(b => b.Position).First();
    Assert.Equal("Bouquet", hero.Block);
    SaveBlockValue(hero.Id, "en", new BlockValue { Name = "title", Text = "Tulips on Friday" });
    Assert.Equal("", PublishRegion(draft));
  }
  Ui.Viewport(1280, 800);
  Ui.Visit("/");
  Assert.Visible("Meadow · Tulips on Friday");
  Ui.Shot("the front page in Meadow — pale paper, green words");
  runas (Anna) { Assert.Equal("", SetLook(MainVersion().Id, "night")); }
  Ui.Visit("/");
  // The same words — staff's — in Night's design.
  Assert.Visible("Night · Tulips on Friday");
  Assert.Hidden("Meadow · Tulips on Friday");
  Assert.Hidden("Evening bouquets");
  Ui.Shot("the same words in Night — near-black paper, pale green");
}

[Test(Florist)]
void what_the_new_look_has_no_design_for_is_listed_before_the_switch() {
  runas (Anna) {
    var main = MainVersion().Id;
    var draft = EditRegion(main, "front", "");
    Assert.Equal("", PublishRegion(draft));
    var behind = LookLeavesBehind(main, "night");
    Assert.Equal(2, behind.Count);
    Assert.Contains("Saying in front — this look has no design for it.", behind);
    Assert.Contains("Pressed flower in front — this look has no design for it.", behind);
    // Nothing is left behind going to the look it already wears.
    Assert.Equal(0, LookLeavesBehind(main, "meadow").Count);
    SetLook(main, "night");
  }
  Ui.Visit("/");
  Assert.Visible("Night · Flowers cut this morning");
  Assert.Hidden("“The peonies lasted two weeks.”");
  Assert.Hidden("✿ A daisy from June");
  // …and it comes back with the look that draws it: nothing was taken out of the arrangement.
  runas (Anna) { SetLook(MainVersion().Id, "meadow"); }
  Ui.Visit("/");
  Assert.Visible("“The peonies lasted two weeks.”");
  Assert.Visible("✿ A daisy from June");
}

[Test(Florist)]
void a_look_a_version_is_only_drafted_in_never_reaches_a_customer() {
  runas (Anna) {
    var night = DuplicateVersion(MainVersion().Id, "Night test");
    SetLook(night, "night");
  }
  Ui.Visit("/");
  Assert.Visible("Meadow · Flowers cut this morning");
  Assert.Hidden("Night ·");
}

[Test(Florist)]
void a_look_name_the_app_does_not_have_is_refused() {
  runas (Anna) {
    Assert.Equal("The app has no look called dusk.", SetLook(MainVersion().Id, "dusk"));
    Assert.Equal("meadow", SiteLook().Look);
  }
}

[Test(Florist)]
void each_block_says_which_looks_draw_it() {
  runas (Anna) {
    var bouquet = BlockTypes().Single(b => b.Name == "Bouquet");
    Assert.False(bouquet.EveryLook);
    Assert.Equal(3, bouquet.Looks.Count);   // Meadow, Night and Frost
    var quote = BlockTypes().Single(b => b.Name == "Saying");
    Assert.Equal(1, quote.Looks.Count);
    Assert.Equal("meadow", quote.Looks[0]);
    var pressed = BlockTypes().Single(b => b.Name == "Florist.Looks.Meadow.Pressed");
    Assert.Equal("meadow", pressed.Looks[0]);
    // One region, "front", declared by each look that draws a front — Frost draws none — and the version's look
    // decides what it allows and its default.
    Assert.Equal(2, SiteRegions().Count(r => r.Name == "front"));
    Assert.Contains("Florist.Looks.Meadow.Pressed", SiteRegions().Single(r => r.Name == "front" && r.Look == "meadow").Allow);
    Assert.Equal("/", SiteRegions().Single(r => r.Name == "front" && r.Look == "night").Page);
  }
}

[Test(Florist)]
void the_general_contract_is_in_the_catalog_as_block_types() {
  runas (Anna) {
    var hero = BlockTypes().Single(b => b.Name == "Osysharp.Site.Looks.Hero");
    Assert.Equal("Hero", hero.Label);
    Assert.Equal(7, hero.Params.Count);
    Assert.Equal(BlockParamKind.Picture, hero.Params.Single(p => p.Name == "photo").Kind);
    // No look of this app draws it — a look kit would.
    Assert.False(hero.EveryLook);
    Assert.Equal(0, hero.Looks.Count);
    foreach (var name in new List<string> { "PictureWithWords", "Quote", "SignUp", "Banner", "PhotoGallery", "Announcement",
                                            "FooterWords", "FooterLink", "OpeningHours", "Address", "FooterSignUp" }) {
      Assert.Equal(1, BlockTypes().Count(b => b.Name == "Osysharp.Site.Looks." + name));
    }
  }
}

/// D-LOOKSDOC1 (b) — Frost draws the bouquet and NO front page. A part with no default design used to draw nothing in
/// a look that skips it, silently; it now falls back to the design the site's default look gives it — Meadow's front —
/// in Frost's own colours, with Frost's own bouquet inside it.
[Test(Florist)]
void a_look_that_skips_the_front_page_draws_the_default_looks_front_in_its_own_colours() {
  runas (Anna) { Assert.Equal("", SetLook(MainVersion().Id, "frost")); }
  Ui.Viewport(1280, 800);
  Ui.Visit("/");
  Assert.Visible("Frost · Flowers cut this morning");
  Ui.Shot("Frost skips the front page — Meadow's front, in Frost's colours");
}
